<html><head><meta charset=UTF-8><title>Pulse Security Guard</title><HTA:APPLICATION ID=Pulse APPLICATIONNAME="Pulse Security Guard" BORDER=thin CAPTION=yes SHOWINTASKBAR=yes SINGLEINSTANCE=yes SYSMENU=yes SCROLL=yes><style>body{background:#0B0B0D;color:#f2f4f6;font-family:'Segoe UI',Inter,sans-serif;margin:0;padding:16px}h1{font-family:Outfit,'Segoe UI',sans-serif;font-size:22px;margin:0}.top{display:flex;align-items:center;gap:14px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.1);border-radius:16px;padding:12px 16px}.ring{width:62px;height:62px;border-radius:50%;display:grid;place-items:center;font-weight:800;font-size:19px;border:7px solid rgba(255,255,255,.08)}.tabs{margin:12px 0}button{padding:9px 16px;border-radius:10px;border:1px solid #333;background:#1a1a1e;color:#fff;cursor:pointer;font-size:13px}button.on{background:#10b981;color:#06110d;font-weight:700}button.go{background:linear-gradient(90deg,#10b981,#38bdf8);color:#06110d;font-weight:800;border:none}table{width:100%;border-collapse:collapse;font-size:13px}td,th{padding:7px 6px;border-bottom:1px solid #1e1e23;text-align:left}tr.hot td{background:rgba(255,107,94,.07)}.badge{padding:3px 10px;border-radius:8px;font-size:12px;font-weight:700;white-space:nowrap}.safe{background:rgba(16,185,129,.15);color:#10b981}.warn{background:rgba(245,158,11,.15);color:#f59e0b}.bad{background:rgba(255,107,94,.2);color:#ff6b5e}.box{border:1px solid #2a2a2e;border-radius:14px;padding:14px;margin:12px 0;background:#141416;font-size:13px;line-height:1.7}input{padding:9px;border-radius:8px;border:1px solid #333;background:#0D0D0F;color:#fff;width:360px}.bar{height:6px;border-radius:4px;background:rgba(255,255,255,.08);margin-top:5px}.bar i{display:block;height:100%;border-radius:4px;background:linear-gradient(90deg,#10b981,#38bdf8)}.bar.hot i{background:linear-gradient(90deg,#f59e0b,#ff6b5e)}.act{padding:5px 12px;border-radius:8px;border:1px solid #ff6b5e;background:rgba(255,107,94,.15);color:#ff6b5e;cursor:pointer;font-size:12px}.foot{color:#666;font-size:11px;margin-top:10px}</style></head><body><div class=top><div class=ring id=ring>–</div><div><h1>&#9673; Pulse Security Guard</h1><div id=sb style=color:#888;font-size:12px>Connessione WMI…</div></div><div style=margin-left:auto;font-size:11px;color:#666>auto-refresh 5s<br><span id=clk></span></div></div><div class=tabs><button id=t1 class=on onclick="ShowTab 1">&#128202; Monitor</button> <button id=t2 onclick="ShowTab 2">&#128737; Sicurezza</button> <button id=t3 onclick="ShowTab 3">&#128640; Startup</button> <button class=go onclick=OneClickClean>&#10024; One-Click Clean</button> <input id=q placeholder="Filtra processi…" onkeyup=RefreshProcs style=width:180px></div><div id=p1><table><thead><tr><th>Processo</th><th style=width:60px>PID</th><th style=width:180px>CPU</th><th style=width:90px>RAM</th><th style=width:150px>Rischio</th><th style=width:70px></th></tr></thead><tbody id=tb></tbody></table><div class=foot>Safety Tag: explorer, csrss, dwm, lsass, wininit, services, smss, winlogon blindati.</div></div><div id=p2 style=display:none><div class=box><b>&#128269; VirusTotal:</b> percorso del file sospetto, calcolo SHA-256 e apro il report.<br><br><input id=vtpath placeholder="C:\…\sospetto.exe"> <button class=go onclick=HashVT>Verifica hash</button><div id=vto style=margin-top:8px></div></div><div class=box><b>&#9760; Trovato virus?</b> 1) Isola il processo. 2) Temp + non firmato = miner/bloatware. 3) Verifica hash qui sopra. 4) Disabilita Startup, riavvia, cancella. 5) Defender offline + cambia password da altro dispositivo.</div></div><div id=p3 style=display:none><div id=st></div><div class=box>Disabilita: Task Manager &gt; Avvio &gt; tasto destro &gt; Disabilita. Voci in Temp = subito.</div></div><script language=VBScript>Dim S:S=Array("explorer","csrss","dwm","lsass","wininit","services","smss","winlogon","fontdrvhost")
Sub Window_OnLoad:window.resizeTo 1100,760:RefreshProcs:LoadStartup:window.setInterval "Tick",5000:End Sub
Sub Tick:document.getElementById("clk").innerText=Time:RefreshProcs:End Sub
Function Prot(n):n=LCase(n):Prot=False:Dim s:For Each s In S:If n=s Or n=s&".exe" Then Prot=True:Exit Function:Next:End Function
Sub ShowTab(n):Dim i:For i=1 To 3:document.getElementById("p"&i).style.display="none":document.getElementById("t"&i).className="":Next:document.getElementById("p"&n).style.display="block":document.getElementById("t"&n).className="on":End Sub
Sub RefreshProcs()
On Error Resume Next:Dim w,c,it,q:q=LCase(document.getElementById("q").value):Set w=GetObject("winmgmts:\\.\root\cimv2"):Set c=w.ExecQuery("SELECT Name,IDProcess,PercentProcessorTime,WorkingSet FROM Win32_PerfFormattedData_PerfProc_Process WHERE Name<>'_Total' AND Name<>'Idle'")
Dim a(250,3),n,i,j:n=0:For Each it In c:If n<250 Then a(n,0)=it.Name:a(n,1)=it.IDProcess:a(n,2)=it.PercentProcessorTime:a(n,3)=it.WorkingSet:n=n+1:Next
For i=0 To n-2:For j=i+1 To n-1:If CLng(a(j,2))>CLng(a(i,2)) Then Dim t0,t1,t2,t3:t0=a(i,0):t1=a(i,1):t2=a(i,2):t3=a(i,3):a(i,0)=a(j,0):a(i,1)=a(j,1):a(i,2)=a(j,2):a(i,3)=a(j,3):a(j,0)=t0:a(j,1)=t1:a(j,2)=t2:a(j,3)=t3:Next:Next
Dim h,t,shown:t=0:shown=0:h="":Dim m:If n>80 Then m=80 Else m=n:Dim cpuAvg,cnt:cpuAvg=0:cnt=0
For i=0 To m-1:Dim nm:nm=CStr(a(i,0)):If q<>"" And InStr(LCase(nm),q)=0 Then GoTo Skip:Dim cpu:cpu=CDbl(a(i,2)):cnt=cnt+1:cpuAvg=cpuAvg+cpu
Dim sc:sc=0:If InStr(LCase(nm),"temp")>0 Then sc=sc+25:If cpu>30 Then sc=sc+30:If Len(nm)>16 Then sc=sc+10
Dim lb,cl:If sc>=60 Then lb="Alto rischio":cl="bad":ElseIf sc>=35 Then lb="Sospetto":cl="warn":ElseIf sc>=15 Then lb="Non firmato":cl="warn":Else lb="Sicuro":cl="safe"
Dim pr:pr=Prot(nm):If pr Then lb="Sistema":cl="safe" Else If sc>=35 Then t=t+1
Dim pc:pc=cpu:If pc>100 Then pc=100:Dim hc:hc="":If sc>=35 Then hc=" class='hot'"
Dim ram:ram=Round(CDbl(a(i,3))/1048576,0)
h=h&"<tr"&hc&">"&"<td><b>"&nm&"</b>"&"<div class='bar"&hc&"'><i style='width:"&pc&"%'></i></div></td><td>"&a(i,1)&"</td><td>"&cpu&"%</td><td>"&ram&" MB</td><td><span class='badge "&cl&"'>"&lb&" "&sc&"</span></td><td><button class=act onclick='KillPid "&a(i,1)&","""&Replace(nm,"""","")&"""'>Isola</button></td></tr>":shown=shown+1:Skip:Next
If shown=0 Then h="<tr><td colspan=6 style=color:#888>Nessun processo (prova a svuotare il filtro).</td></tr>"
document.getElementById("tb").innerHTML=h
Dim ring:If cnt>0 Then ring=Round(100-(cpuAvg/cnt)*1.2,0) Else ring=100:If ring<0 Then ring=0:If ring>100 Then ring=100
Dim rc:rc=document.getElementById("ring"):rc.innerText=ring:Dim col:col="#10b981":If ring<45 Then col="#ff6b5e" ElseIf ring<75 Then col="#f59e0b":rc.style.color=col:rc.style.borderColor="rgba(255,255,255,.08)":rc.style.borderTopColor=col:rc.style.borderRightColor=col
If t>0 Then document.getElementById("sb").innerHTML="<b style='color:#ff6b5e'>"&t&" minacce attive</b> — "&Now Else document.getElementById("sb").innerHTML="<b style='color:#10b981'>Sistema sicuro</b> — "&Now
End Sub
Sub KillPid(pid,name):If Prot(name) Then MsgBox name&" protetto dal Safety Tag: kill bloccata.",48,"Pulse":Exit Sub:If MsgBox("Isolare "&name&" ("&pid&")?",4+32,"Pulse")<>6 Then Exit Sub:On Error Resume Next:Dim w:Set w=GetObject("winmgmts:\\.\root\cimv2"):If w.Get("Win32_Process.Handle='"&pid&"'").Terminate()=0 Then MsgBox "Isolato: "&name,64,"Pulse" Else MsgBox "Kill fallito: riavvia l'app come amministratore.",16,"Pulse":RefreshProcs:End Sub
Sub OneClickClean():If MsgBox("Termino i non-essenziali ad alto carico? Max 10, critici protetti.",4+32,"Pulse")<>6 Then Exit Sub:On Error Resume Next:Dim w,c,it,k:k=0:Set w=GetObject("winmgmts:\\.\root\cimv2"):Set c=w.ExecQuery("SELECT Name,IDProcess,PercentProcessorTime FROM Win32_PerfFormattedData_PerfProc_Process WHERE PercentProcessorTime>30"):For Each it In c:If k>=10 Then Exit For:If Not Prot(it.Name) And LCase(it.Name)<>"_total" And LCase(it.Name)<>"idle" Then If w.Get("Win32_Process.Handle='"&it.IDProcess&"'").Terminate()=0 Then k=k+1:Next:MsgBox "Isolati: "&k&" processi. Critici intatti.",64,"Pulse":RefreshProcs:End Sub
Sub LoadStartup():On Error Resume Next:Dim w,v,t,i,h:Set w=GetObject("winmgmts:\\.\root\default:StdRegProv"):h="<div class=box><b>HKCU …\Run</b><br>":w.EnumValues &H80000001,"Software\Microsoft\Windows\CurrentVersion\Run",v,t:If IsArray(v) Then For i=0 To UBound(v):h=h&"&#8226; "&v(i)&"<br>":Next Else h=h&"(vuoto)<br>":h=h&"</div><div class=box><b>HKLM …\Run</b><br>":w.EnumValues &H80000002,"Software\Microsoft\Windows\CurrentVersion\Run",v,t:If IsArray(v) Then For i=0 To UBound(v):h=h&"&#8226; "&v(i)&"<br>":Next Else h=h&"(vuoto)<br>":h=h&"</div>":document.getElementById("st").innerHTML=h:End Sub
Sub HashVT():Dim f:f=Trim(document.getElementById("vtpath").value):If f="" Then document.getElementById("vto").innerHTML="Incolla il percorso del file.":Exit Sub:On Error Resume Next:Dim s,e:Set s=CreateObject("WScript.Shell"):Set e=s.Exec("certutil -hashfile """&f&""" SHA256"):Dim o:o=e.StdOut.ReadAll:Dim hh:hh=Trim(Split(o,vbCrLf)(1)):document.getElementById("vto").innerHTML="SHA-256: <b>"&hh&"</b> — apro VirusTotal…":s.Run "https://www.virustotal.com/gui/file/"&hh,1,False:End Sub
</script></body></html>
