<html><head><meta charset=UTF-8><title>Pulse Security Guard</title><HTA:APPLICATION ID=Pulse APPLICATIONNAME="Pulse Security Guard" BORDER=thin CAPTION=yes SHOWINTASKBAR=yes SINGLEINSTANCE=yes SYSMENU=yes SCROLL=yes><style>body{background:#0D0D0F;color:#f2f4f6;font-family:'Segoe UI',sans-serif;margin:0;padding:16px}button{padding:8px 14px;border-radius:10px;border:1px solid #333;background:#1a1a1e;color:#fff;cursor:pointer}table{width:100%;border-collapse:collapse;font-size:13px}td,th{padding:6px;border-bottom:1px solid #222}.badge{padding:3px 10px;border-radius:8px;font-size:12px;font-weight:700}.safe{background:rgba(16,185,129,.15);color:#10b981}.warn{background:rgba(245,158,11,.15);color:#f59e0b}.bad{background:rgba(255,107,94,.18);color:#ff6b5e}.box{border:1px solid #2a2a2e;border-radius:12px;padding:12px;margin:10px 0;background:#141416}input{padding:8px;border-radius:8px;border:1px solid #333;background:#0D0D0F;color:#fff;width:380px}</style></head><body><h1>Pulse Security Guard <span style=font-size:12px;color:#888>v1.1.1 app Windows</span></h1><div id=sb style=color:#888>Caricamento…</div><p><button onclick="ShowTab 1">Monitor</button> <button onclick="ShowTab 2">Sicurezza</button> <button onclick="ShowTab 3">Startup</button> <button onclick="OneClickClean">One-Click Clean</button> <button onclick="RefreshProcs">Aggiorna</button></p><div id=p1><table><thead><tr><th>Processo</th><th>PID</th><th>CPU %</th><th>RAM MB</th><th>Rischio</th><th></th></tr></thead><tbody id=tb></tbody></table></div><div id=p2 style=display:none><div class=box><b>VirusTotal:</b> percorso file sospetto<br><input id=vtpath><button onclick=HashVT>Verifica hash</button><div id=vto></div></div><div class=box><b>Virus? Fai cosi:</b> isola, firma/percorso, hash su VT, disabilita Startup, Defender offline.</div></div><div id=p3 style=display:none><div id=st></div></div><script language=VBScript>Dim S:S=Array("explorer","csrss","dwm","lsass","wininit","services","smss","winlogon","fontdrvhost")
Sub Window_OnLoad:window.resizeTo 1080,740:RefreshProcs:LoadStartup:End Sub
Function Prot(n):n=LCase(n):Prot=False:Dim s:For Each s In S:If n=s Or n=s&".exe" Then Prot=True:Exit Function:Next:End Function
Sub ShowTab(n):document.getElementById("p1").style.display="none":document.getElementById("p2").style.display="none":document.getElementById("p3").style.display="none":document.getElementById("p"&n).style.display="block":End Sub
Sub RefreshProcs()
On Error Resume Next:Dim w,c,it,h,r,t:t=0:Set w=GetObject("winmgmts:\\.\root\cimv2"):Set c=w.ExecQuery("SELECT Name,IDProcess,PercentProcessorTime,WorkingSet FROM Win32_PerfFormattedData_PerfProc_Process WHERE Name<>'_Total' AND Name<>'Idle'"):h="":Dim a(200,3),n,i,j:n=0:For Each it In c:If n<200 Then a(n,0)=it.Name:a(n,1)=it.IDProcess:a(n,2)=it.PercentProcessorTime:a(n,3)=it.WorkingSet:n=n+1:Next:For i=0 To n-2:For j=i+1 To n-1:If CLng(a(j,2))>CLng(a(i,2)) Then Dim t0,t1,t2,t3:t0=a(i,0):t1=a(i,1):t2=a(i,2):t3=a(i,3):a(i,0)=a(j,0):a(i,1)=a(j,1):a(i,2)=a(j,2):a(i,3)=a(j,3):a(j,0)=t0:a(j,1)=t1:a(j,2)=t2:a(j,3)=t3:Next:Next:Dim m:If n>60 Then m=60 Else m=n:For i=0 To m-1:Dim sc,lb,cl:sc=0:If InStr(LCase(a(i,0)),"temp")>0 Then sc=sc+25:If CDbl(a(i,2))>30 Then sc=sc+30:If Len(a(i,0))>16 Then sc=sc+10:If sc>=60 Then lb="Alto rischio":cl="bad":ElseIf sc>=35 Then lb="Sospetto":cl="warn":ElseIf sc>=15 Then lb="Non firmato":cl="warn":Else lb="Sicuro":cl="safe":If Prot(CStr(a(i,0))) Then lb="Sistema":cl="safe":Else If sc>=35 Then t=t+1:Dim rc:rc="":If sc>=35 Then rc=" style='background:rgba(255,107,94,.07)'":h=h&"<tr"&rc&">"&"<td><b>"&a(i,0)&"</b></td><td>"&a(i,1)&"</td><td>"&a(i,2)&"%</td><td>"&Round(CDbl(a(i,3))/1048576,0)&"</td><td><span class='badge "&cl&"'>"&lb&" "&sc&"</span></td><td><button onclick='KillPid "&a(i,1)&","""&a(i,0)&"""'>Isola</button></td></tr>":Next:document.getElementById("tb").innerHTML=h:If t>0 Then document.getElementById("sb").innerHTML="<b style='color:#ff6b5e'>"&t&" minacce attive</b>" Else document.getElementById("sb").innerHTML="<b style='color:#10b981'>Sistema sicuro</b>"
End Sub
Sub KillPid(pid,name):If Prot(name) Then MsgBox name&" protetto dal Safety Tag.",48,"Pulse":Exit Sub:If MsgBox("Isolare "&name&"?",4+32,"Pulse")<>6 Then Exit Sub:On Error Resume Next:Dim w:Set w=GetObject("winmgmts:\\.\root\cimv2"):If w.Get("Win32_Process.Handle='"&pid&"'").Terminate()=0 Then MsgBox "Isolato.",64,"Pulse" Else MsgBox "Avvia come amministratore.",16,"Pulse":RefreshProcs:End Sub
Sub OneClickClean():If MsgBox("One-Click Clean? Critici protetti.",4+32,"Pulse")<>6 Then Exit Sub:On Error Resume Next:Dim w,c,it,k:k=0:Set w=GetObject("winmgmts:\\.\root\cimv2"):Set c=w.ExecQuery("SELECT Name,IDProcess,PercentProcessorTime FROM Win32_PerfFormattedData_PerfProc_Process WHERE PercentProcessorTime>30"):For Each it In c:If k>=10 Then Exit For:If Not Prot(it.Name) And LCase(it.Name)<>"_total" And LCase(it.Name)<>"idle" Then If w.Get("Win32_Process.Handle='"&it.IDProcess&"'").Terminate()=0 Then k=k+1:Next:MsgBox "Isolati: "&k,64,"Pulse":RefreshProcs:End Sub
Sub LoadStartup():On Error Resume Next:Dim w,r,v,t,i,h:Set w=GetObject("winmgmts:\\.\root\default:StdRegProv"):h="<div class=box><b>HKCU Run</b><br>":w.EnumValues &H80000001,"Software\Microsoft\Windows\CurrentVersion\Run",v,t:If IsArray(v) Then For i=0 To UBound(v):h=h&v(i)&"<br>":Next Else h=h&"(vuoto)<br>":h=h&"</div><div class=box><b>HKLM Run</b><br>":w.EnumValues &H80000002,"Software\Microsoft\Windows\CurrentVersion\Run",v,t:If IsArray(v) Then For i=0 To UBound(v):h=h&v(i)&"<br>":Next Else h=h&"(vuoto)<br>":h=h&"</div>":document.getElementById("st").innerHTML=h:End Sub
Sub HashVT():Dim f:f=Trim(document.getElementById("vtpath").value):If f="" Then Exit Sub:On Error Resume Next:Dim s,e:Set s=CreateObject("WScript.Shell"):Set e=s.Exec("certutil -hashfile """&f&""" SHA256"):Dim o:o=e.StdOut.ReadAll:Dim hh:hh=Trim(Split(o,vbCrLf)(1)):document.getElementById("vto").innerHTML="SHA-256: <b>"&hh&"</b>":s.Run "https://www.virustotal.com/gui/file/"&hh,1,False:End Sub
</script></body></html>
